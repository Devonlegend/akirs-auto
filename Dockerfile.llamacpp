# llama.cpp CPU inference server with an entrypoint that downloads the GGUF
# model at container start (not baked into the image, not committed to git).
# The download is cached in a named volume so restarts don't re-download.

FROM ghcr.io/ggml-org/llama.cpp:server

COPY docker/llamacpp-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

# Default flags — docker-compose.yml can override via `command:`.
CMD ["-m", "/models/gemma-3-1b-it-Q4_K_M.gguf", \
     "--host", "0.0.0.0", "--port", "8080", \
     "-c", "2048", \
     "-t", "4", \
     "-ngl", "0", \
     "--parallel", "1", \
     "--jinja", \
     "--cache-type-k", "q8_0", "--cache-type-v", "q8_0"]
